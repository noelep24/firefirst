# Copy to .env (or set in your host) and adjust.
DATABASE_URL=postgres://firefirst:firefirst@localhost:5432/firefirst
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production (DJANGO_DEBUG=false) also uses:
# DJANGO_ALLOWED_HOSTS=firefirst.example.com
# CSRF_TRUSTED_ORIGINS=https://firefirst.example.com
# DJANGO_SECURE_SSL_REDIRECT=true      # false only if nothing in front terminates TLS
# DJANGO_HSTS_SECONDS=2592000
# WEB_CONCURRENCY=3                    # gunicorn workers
